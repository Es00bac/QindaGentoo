 void LinuxDmabuf::setSupportedModifiers(const QHash<uint32_t, QList<uint64_t>> &modifiers)
 {
     Q_ASSERT(resourceMap().isEmpty());
     m_modifiers = modifiers;
+
+    // The format table for dma-buf feedback. Implicit modifiers (DRM_FORMAT_MOD_INVALID) are
+    // always importable, so every format lists them besides its explicit modifiers.
+    struct FormatTableEntry {
+        uint32_t format;
+        uint32_t padding;
+        uint64_t modifier;
+    };
+    QList<FormatTableEntry> table;
+    for (auto it = m_modifiers.constBegin(); it != m_modifiers.constEnd(); ++it) {
+        for (uint64_t modifier : it.value())
+            table.append({it.key(), 0, modifier});
+        if (!it.value().contains(DRM_FORMAT_MOD_INVALID))
+            table.append({it.key(), 0, DRM_FORMAT_MOD_INVALID});
+    }
+    if (table.size() > 0xFFFF)
+        table.resize(0xFFFF);
+
+    if (m_formatTableFd != -1)
+        close(m_formatTableFd);
+    m_formatTableFd = memfd_create("qt-dmabuf-format-table", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    m_formatTableSize = 0;
+    m_trancheIndices.clear();
+    if (m_formatTableFd == -1) {
+        qWarning("linux-dmabuf: cannot create the feedback format table");
+        return;
+    }
+    const auto bytes = qsizetype(table.size() * sizeof(FormatTableEntry));
+    if (write(m_formatTableFd, table.constData(), bytes) != bytes) {
+        qWarning("linux-dmabuf: cannot write the feedback format table");
+        close(m_formatTableFd);
+        m_formatTableFd = -1;
+        return;
+    }
+    // Clients map the table privately; nobody may change it underneath them.
+    fcntl(m_formatTableFd, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE | F_SEAL_SEAL);
+    m_formatTableSize = uint32_t(bytes);
+    for (qsizetype i = 0; i < table.size(); ++i) {
+        const uint16_t index = uint16_t(i);
+        m_trancheIndices.append(reinterpret_cast<const char *>(&index), sizeof(index));
+    }
 }
 
