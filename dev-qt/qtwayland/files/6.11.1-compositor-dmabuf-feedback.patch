+void LinuxDmabuf::zwp_linux_dmabuf_v1_get_surface_feedback(Resource *resource, uint32_t id, struct ::wl_resource *surface)
+{
+    Q_UNUSED(surface);
+    // One GPU and no direct scan-out: every surface gets the default feedback.
+    sendFeedback(resource, id);
+}
+
+void LinuxDmabuf::sendFeedback(Resource *resource, uint32_t id)
+{
+    auto *feedback = new LinuxDmabufFeedback(resource->client(), id, resource->version()); // deleted with its resource
+    const QByteArray device(reinterpret_cast<const char *>(&m_mainDevice), sizeof(m_mainDevice));
+    if (m_formatTableFd != -1)
+        feedback->send_format_table(m_formatTableFd, m_formatTableSize);
+    feedback->send_main_device(device);
+    feedback->send_tranche_target_device(device);
+    feedback->send_tranche_flags(0);
+    feedback->send_tranche_formats(m_trancheIndices);
+    feedback->send_tranche_done();
+    feedback->send_done();
+}
