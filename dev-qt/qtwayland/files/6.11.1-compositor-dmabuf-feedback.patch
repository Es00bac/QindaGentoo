 #include <EGL/eglext.h>
 #include <unistd.h>
 #include <drm_fourcc.h>
+#include <sys/stat.h>
+#include <cstring>
 
 QT_BEGIN_NAMESPACE
 
+// The DRM device behind an EGL display, render node preferred, for dma-buf feedback.
+static bool queryMainDevice(EGLDisplay display, dev_t *device)
+{
+    auto queryDisplayAttrib = reinterpret_cast<PFNEGLQUERYDISPLAYATTRIBEXTPROC>(eglGetProcAddress("eglQueryDisplayAttribEXT"));
+    auto queryDeviceString = reinterpret_cast<PFNEGLQUERYDEVICESTRINGEXTPROC>(eglGetProcAddress("eglQueryDeviceStringEXT"));
+    if (!queryDisplayAttrib || !queryDeviceString)
+        return false;
+    EGLAttrib attrib = 0;
+    if (!queryDisplayAttrib(display, EGL_DEVICE_EXT, &attrib) || !attrib)
+        return false;
+    const auto eglDevice = reinterpret_cast<EGLDeviceEXT>(attrib);
+    const char *extensions = queryDeviceString(eglDevice, EGL_EXTENSIONS);
+    const char *node = nullptr;
+#ifdef EGL_DRM_RENDER_NODE_FILE_EXT
+    if (extensions && strstr(extensions, "EGL_EXT_device_drm_render_node"))
+        node = queryDeviceString(eglDevice, EGL_DRM_RENDER_NODE_FILE_EXT);
+#endif
+    if (!node && extensions && strstr(extensions, "EGL_EXT_device_drm"))
+        node = queryDeviceString(eglDevice, EGL_DRM_DEVICE_FILE_EXT);
+    struct stat st;
+    if (!node || stat(node, &st) != 0)
+        return false;
+    *device = st.st_rdev;
+    return true;
+}
