+            d->send_frame(resource->handle);
 }
 
 /*!
@@ -160,9 +171,11 @@
 void QWaylandTouch::sendCancelEvent(QWaylandClient *client)
 {
     Q_D(QWaylandTouch);
-    auto focusResource = d->resourceMap().value(client->client());
-    if (focusResource)
-        d->send_cancel(focusResource->handle);
+    for (auto *resource : d->resourceMap().values(client->client())) {
+        if (d->activeContacts.remove(resource))
+            d->send_cancel(resource->handle);
+        d->pendingFrames.remove(resource);
+    }
 }
 
 /*!
@@ -176,6 +189,8 @@
     Q_D(QWaylandTouch);
     if (event->type() == QEvent::TouchCancel) {
         sendCancelEvent(surface->client());
+        for (auto &id : d->ids)
+            id = -1;
         return;
     }
 
