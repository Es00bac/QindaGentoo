+                           modsLatched, modsLocked, group);
 
         Qt::KeyboardModifiers currentState = Qt::NoModifier;
         if (xkb_state_mod_index_is_active(xkbState(), shiftIndex, XKB_STATE_MODS_EFFECTIVE) == 1)
@@ -253,13 +270,10 @@
