From: QindaQt contributors
Subject: [PATCH] Wayland compositor: deliver keyboard state to every focused client resource

Firefox binds GTK and Mozilla keyboard listeners on the same Wayland connection.
Fan out enter/leave, key and every modifier path, including the public explicit
sendKeyModifiers API, late binds and surviving resources. No data layout change.
QindaWeb carries a same-client protocol regression and actual native Gecko gate.

--- a/src/compositor/compositor_api/qwaylandkeyboard.cpp
+++ b/src/compositor/compositor_api/qwaylandkeyboard.cpp
@@ -46,6 +46,11 @@
     return keyboard->d_func();
 }
 
+QList<QWaylandKeyboardPrivate::Resource *> QWaylandKeyboardPrivate::focusResources() const
+{
+    return focus ? resourceMap().values(focus->waylandClient()) : QList<Resource *>{};
+}
+
 void QWaylandKeyboardPrivate::checkFocusResource(Resource *keyboardResource)
 {
     if (!keyboardResource || !focus)
@@ -74,10 +79,9 @@
     if (surface && surface->isCursorSurface())
         surface = nullptr;
     if (focus != surface) {
-        if (focusResource) {
-            uint32_t serial = compositor()->nextSerial();
-            send_leave(focusResource->handle, serial, focus->resource());
-        }
+        const uint32_t serial = compositor()->nextSerial();
+        for (Resource *resource : focusResources())
+            send_leave(resource->handle, serial, focus->resource());
         focusDestroyListener.reset();
         if (surface)
             focusDestroyListener.listenForDestruction(surface->resource());
@@ -85,8 +89,12 @@
 
     Resource *resource = surface ? resourceMap().value(surface->waylandClient()) : 0;
 
-    if (resource && (focus != surface || focusResource != resource))
-        sendEnter(surface, resource);
+    // Every keyboard object for the focused client represents this seat.
+    // GTK and Firefox may bind it separately on the same connection.
+    if (surface && (focus != surface || !focusResource)) {
+        for (Resource *keyboardResource : resourceMap().values(surface->waylandClient()))
+            sendEnter(surface, keyboardResource);
+    }
 
     focusResource = resource;
     focus = surface;
@@ -117,8 +125,15 @@
 
 void QWaylandKeyboardPrivate::keyboard_destroy_resource(wl_keyboard::Resource *resource)
 {
-    if (focusResource == resource)
+    if (focusResource == resource) {
         focusResource = nullptr;
+        for (Resource *remaining : focusResources()) {
+            if (remaining != resource) {
+                focusResource = remaining;
+                break;
+            }
+        }
+    }
 }
 
 void QWaylandKeyboardPrivate::keyboard_release(wl_keyboard::Resource *resource)
