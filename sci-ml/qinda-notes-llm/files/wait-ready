#!/bin/sh
# Wait until qinda-notes-llm-server's llama-server reports the model loaded;
# give up at once if it exited (bad serve.env) instead of waiting it out.
for _ in $(seq 1 340); do
	curl -sf -o /dev/null "http://127.0.0.1:${NOTES_BACKEND_PORT}/health" && exit 0
	if [ -n "${MAINPID}" ] && ! kill -0 "${MAINPID}" 2>/dev/null; then
		echo "llama-server exited while loading" >&2
		exit 1
	fi
	sleep 0.5
done
echo "llama-server did not become ready" >&2
exit 1
