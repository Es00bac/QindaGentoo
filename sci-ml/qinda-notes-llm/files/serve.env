# qinda-notes-llm settings (sci-ml/qinda-notes-llm), read by
# qinda-notes-llm-server.service and qinda-notes-llm.service.
# Clients talk to the socket on 127.0.0.1:8080 (qinda-notes-llm.socket);
# llama-server itself listens on the backend port below, loopback only.

NOTES_BACKEND_PORT=18080
# Unload the model after this long without a connection (systemd time span).
NOTES_IDLE_EXIT=15min

# The model the package installed, and the id clients send as "model".
NOTES_MODEL=/usr/share/gguf/Qwen3.5-4B-UD-Q4_K_XL.gguf
NOTES_ALIAS=qwen3.5-4b
# Context window in tokens. Qwen3.5's hybrid attention keeps the cache small.
NOTES_CTX=32768

# Everything on the GPU (Vulkan), one request at a time, thinking off: live
# notes want the answer, not a reasoning trace, and it costs minutes on an iGPU.
NOTES_ARGS=--n-gpu-layers 99 --parallel 1 --reasoning-budget 0 @MMPROJ@
