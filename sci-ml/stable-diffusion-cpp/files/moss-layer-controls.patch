+    std::vector<int> moss_uncond_layers = {22};
+    for (const auto& entry : parse_key_value_args(extra_sample_args, "extra sample arg")) {
+        if (entry.first != "moss_uncond_layers") continue;
+        moss_uncond_layers.clear();
+        if (entry.second == "none") continue;
+        std::istringstream indices(entry.second);
+        std::string token;
+        while (std::getline(indices, token, ':')) {
+            size_t consumed = 0;
+            int index = -1;
+            try { index = std::stoi(token, &consumed); } catch (...) {}
+            if (consumed != token.size() || index < 0 || index >= 42) {
+                LOG_ERROR("Invalid MOSS layer index: %s", token.c_str());
+                return {};
+            }
+            moss_uncond_layers.push_back(index);
+        }
+    }
 
