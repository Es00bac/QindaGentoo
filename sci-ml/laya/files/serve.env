# laya-serve settings (sci-ml/laya), read by laya-serve.service.
# Documented in laya/serve.py; LAYA_MODEL_DIR is the Gentoo addition.

# Loopback only. To serve other machines (e.g. over Tailscale), set the
# address here AND an API key below; clients send "Authorization: Bearer <key>".
LAYA_HOST=127.0.0.1
LAYA_PORT=8000
#LAYA_API_KEY=

# The checkpoints sci-ml/laya-models installed (english, multilingual,
# typed-decisions). Every installed one is preloaded unless LAYA_MODELS
# names a subset.
LAYA_MODEL_DIR=/usr/share/laya
#LAYA_MODELS=english

# cpu, cuda, or empty for automatic. A preference: a missing GPU falls back.
LAYA_DEVICE=cpu
# Cap torch's CPU threads so the gate does not compete with the desktop.
#LAYA_THREADS=4
