# The QindaQt overlay packages are ~amd64 checkpoints.
app-office/obsidian ~amd64
gui-wm/qindaqt-desktop ~amd64
gui-apps/qindaqt-apps ~amd64
gui-apps/qindaoffice ~amd64
# The toolkit the whole office suite's UI is built from (D-031); it comes
# in as qindaoffice's dependency, so it needs accepting the same way.
dev-libs/qindatk ~amd64
gui-apps/qqterm ~amd64
gui-apps/qindaqt-system-monitor ~amd64
# The desktop's org.qindaqt.Voice1 provider: dictation into any window.
app-accessibility/gabbee ~amd64
# Gabbee's active-window typing route uses dotool on Wayland.
x11-misc/dotool ~amd64
# Versioned appearance pack authored on qinda-top.
x11-themes/qinda-seven ~amd64
# Its offline dictation (gabbee[whisper]): faster-whisper, its CTranslate2
# runtime, the models and PyAV from this overlay, and the parts of the
# Hugging Face stack that ::gentoo keeps in testing.
dev-python/faster-whisper ~amd64
sci-ml/ctranslate2 ~amd64
app-accessibility/faster-whisper-models ~amd64
dev-python/av ~amd64
sci-ml/tokenizers ~amd64
sci-ml/huggingface_hub ~amd64
sci-ml/hf_xet ~amd64
dev-util/opencode-bin ~amd64
www-client/qindafox-bin ~amd64
media-libs/noise-suppression-for-voice ~amd64
kde-plasma/sloom-globalmenu ~amd64
kde-plasma/sloom-panelmenu ~amd64
media-gfx/sloom-studio-bin ~amd64
# OBS Studio is an integrated part of the QindaQt desktop (Streaming route,
# OBS applet, console-bus bridge, virtual camera): ::gentoo keeps it and the
# v4l2loopback module in testing, so the profile accepts them for every machine.
media-video/obs-studio ~amd64
media-video/v4l2loopback ~amd64
media-plugins/obs-qindaqt ~amd64
# Venus Pro Config (QindaVenusPro) and the python-hidapi binding it opens the mouse with.
app-misc/venusprolinux ~amd64
dev-python/hidapi ~amd64
# Idle screensavers started by qindaqt-desktop-controls.
x11-misc/qinda-patrol ~amd64
x11-misc/circuit-reef ~amd64
x11-misc/prism-circuit ~amd64
x11-misc/prism-brawl ~amd64
x11-misc/starward-reimagined ~amd64
