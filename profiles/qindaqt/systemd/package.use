gui-wm/qindaqt-kwin screencast systemd accessibility
dev-qt/qtbase wayland X gui widgets opengl libinput cups accessibility
# The independent printing component supplies filters, drivers and discovery.
net-print/cups dbus systemd usb zeroconf
net-print/cups-browsed zeroconf
net-print/libcupsfilters poppler postscript
net-print/gutenprint cups
net-dns/avahi dbus systemd
app-admin/system-config-printer policykit
sys-apps/systemd boot cryptsetup pam policykit
sys-kernel/installkernel dracut systemd-boot
sys-kernel/linux-firmware initramfs redistributable unknown-license dist-kernel compress-zstd deduplicate
x11-misc/sddm systemd -elogind
sys-auth/polkit systemd
media-libs/mesa vulkan vaapi zstd
media-video/pipewire sound-server pipewire-alsa extra-client-tools dbus bluetooth -ffmpeg
# QindaQt's OBS integration needs obs-websocket (the desktop's control channel),
# V4L2 output (the virtual camera) and PipeWire/Wayland capture.
media-video/obs-studio websocket v4l wayland screencast
# app-misc/venusprolinux[qindatk] loads the QindaTK QML module through PyQt6's
# QtQml/QtQuick bindings, which dev-python/pyqt6 does not enable by default.
dev-python/pyqt6 qml quick
# app-accessibility/gabbee records the microphone with pw-record, which
# media-video/pipewire builds only with USE=extra (it is a pw-cat link).
media-video/pipewire extra
# Gabbee's primary text-delivery route is its own IBus engine, and its
# accessibility route walks AT-SPI; both go through GObject introspection.
app-i18n/ibus introspection
app-accessibility/at-spi2-core introspection

# QindaLutris's built-in store sign-in (ADR-0275 section 4) shows the store's
# own login page in an embedded web view. qtwebengine must match qtbase's
# accessibility flag, which this profile enables.
dev-qt/qtwebengine accessibility

# sci-ml/qinda-llm-server runs llama.cpp on the GPU through Vulkan (RADV):
# ROCm does not support qinda's RX 5700 XT (gfx1010).
sci-misc/llama-cpp vulkan

# Laya (sci-ml/laya) runs its checkpoints through transformers' PyTorch
# backend (QindaOffice D-057).
sci-ml/transformers torch

# QindaStudio's offline Face-Aware qualification uses the licensed NASA
# fixtures shipped by the model data package; keep them managed by Portage.
sci-ml/opencv-face-liquify-models test-fixtures

# Match the qinda-built browser binary's headless test coverage (no runtime change).
=www-client/qindaweb-0.1.0_alpha1 test

# Native session: retain user applications without Plasma-only integrations.
media-gfx/sloom-studio-bin -globalmenu
x11-misc/xdg-utils -plasma
lxqt-base/lxqt-config -monitor
kde-misc/kdeconnect -plasmoid
app-misc/claude-desktop-bin qindaqt
virtual/secret-service qindaqt
# QtKeychain must compile its Secret Service backend to use QindaQt Keyring;
# otherwise non-KDE desktops still fall back to the activatable KWallet daemon.
dev-libs/qtkeychain keyring
x11-misc/sddm qindaqt
