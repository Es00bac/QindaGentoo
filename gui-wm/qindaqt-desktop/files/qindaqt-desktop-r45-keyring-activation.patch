+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# D-Bus activation helper for org.freedesktop.secrets (ADR-0430).
+#
+# AGENT-CONTRACT: pam_qindaqt_keyring starts the trusted
+# qindaqt-keyring@UID.service while PAM opens the session, before the
+# compositor creates its Wayland socket. Ordinary activation therefore starts
+# the prompt-only user daemon only beside a live compositor. Starting it before
+# login lets it own org.freedesktop.secrets first; the trusted owner then exits
+# 3 and the login password is never delivered (keyring-pam.md).
+#
+# AGENT-GUARD: refuse by exiting. dbus-daemon fails the caller at once when the
+# process it spawned exits, but a SystemdService= unit that is skipped or fails
+# leaves the caller waiting service_start_timeout (120 s on the session bus).
+set -u
+PATH=/usr/bin:/bin
+display=${WAYLAND_DISPLAY:-}
+[ -n "$display" ] || exit 1
+case $display in
+    /*) socket=$display ;;
+    *) [ -n "${XDG_RUNTIME_DIR:-}" ] || exit 1; socket=$XDG_RUNTIME_DIR/$display ;;
+esac
+lock=$socket.lock
+[ -S "$socket" ] && [ -f "$lock" ] || exit 1
+# AGENT-NOTE: libwayland flocks the lock file for the compositor's lifetime;
+# a socket left by a crashed compositor has no holder. Read the holder from
+# /proc/locks rather than taking the lock: a held probe lock would make a
+# compositor starting at that instant fail to bind its socket.
+device=$(stat -c %d -- "$lock") && inode=$(stat -c %i -- "$lock") || exit 1
+id=$(printf '%02x:%02x:%s' $(((device >> 8) & 0xfff)) \
+    $(((device & 0xff) | ((device >> 12) & 0xfff00))) "$inode")
+grep -Eq "^[0-9]+: FLOCK +ADVISORY +WRITE +[0-9]+ $id " /proc/locks || exit 1
+exec systemctl --user start qindaqt-keyring.service
