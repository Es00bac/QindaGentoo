+        .arg(value.executable.isEmpty() ? tr("Unavailable") : protocol::promptDisplayText(value.executable))
+        .arg(requesterKnown ? QString::number(value.userId) : tr("Unavailable")).arg(protocol::promptDisplayText(value.caller));
