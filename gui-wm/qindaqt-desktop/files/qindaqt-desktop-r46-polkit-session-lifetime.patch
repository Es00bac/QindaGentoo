+        if (!m_done) {
+            m_session.setResponse(response);
+        }
+    }
+    void cancel() override
+    {
+        if (!m_done) {
+            m_session.cancel();
+        }
+    }
 
 private:
     PolkitQt1::Agent::Session m_session;
+    bool m_done = false;
